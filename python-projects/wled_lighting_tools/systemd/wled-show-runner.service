# Install (adjust User and paths if the repo isn't at /home/pi/makerspace-code):
#   sudo cp systemd/wled-show-runner.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now wled-show-runner
#   journalctl -u wled-show-runner -f
[Unit]
Description=Lighted sculpture show runner (DDP to WLED)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/makerspace-code/python-projects/wled_lighting_tools
ExecStart=/home/pi/makerspace-code/python-projects/wled_lighting_tools/.venv/bin/python runner.py
Restart=always
RestartSec=5
# Unbuffered so log lines reach journald immediately
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
