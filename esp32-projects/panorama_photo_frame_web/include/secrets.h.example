#pragma once

// Copy this file to secrets.h (gitignored, never commit the real one)
// and fill in your actual WiFi credentials. See README.md's Security
// section for why this split exists.

#define WIFI_SSID "your-network-name"
#define WIFI_PASSWORD "your-network-password"

// Optional HTTP Basic Auth for the web interface. Both are commented out by
// default, which leaves the server wide open to anyone on your LAN --
// including the photo upload route. Uncomment BOTH and set a real password to
// turn auth on for every route at once; requireAuth() in src/web.cpp already
// guards them all. Note Basic Auth over plain HTTP sends the password in
// near-cleartext on every request: it raises the bar against casual access on
// a trusted network, not against anyone sniffing traffic.

// #define WEB_AUTH_USER "frame"
