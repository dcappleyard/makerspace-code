// The eink_photo_server, as this frame reaches it (an IP is safer than a
// .local/.lan name), and this frame's token -- the same `token` as its entry in
// the server's devices.yaml (protocol: esp32_pull, pipeline: ee03_gray16).
#define SERVER_URL "http://192.168.30.10:8080"
#define DEVICE_TOKEN "CHANGE_ME_TOKEN_2"

