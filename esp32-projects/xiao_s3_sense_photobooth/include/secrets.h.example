#pragma once

// Optional. Copy this file to secrets.h (gitignored -- never commit the real
// one) and fill in real values to have the booth set its clock from NTP at
// boot. WiFi is switched off again straight after. Without secrets.h the
// booth still builds and runs, keeping time on the round display's RTC.

#define WIFI_SSID "your-network-name"
#define WIFI_PASSWORD "your-network-password"

// Optional, needs the WiFi above: send each new photo to the eink_photo_server
// (python-projects/eink_photo_server) when the booth goes to sleep. The token
// is the `upload_token` of the photobooth entry under `sources:` in the
// server's devices.yaml. Use an IP for the server -- safer than a .local name.
#define SERVER_URL "http://192.168.30.10:8080"
#define UPLOAD_TOKEN "CHANGE_ME_UPLOAD_TOKEN"
