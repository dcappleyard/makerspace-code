#pragma once

// Copy this file to secrets.h (gitignored -- never commit the real one) and
// fill in real values.

#define WIFI_SSID "your-network-name"
#define WIFI_PASSWORD "your-network-password"

// The eink_photo_server, as the frames reach it (an IP is safer than a
// .local/.lan name).
#define SERVER_URL "http://192.168.30.10:8080"

// One token per frame -- each the `token` of that frame's own entry in the
// server's devices.yaml (protocol: esp32_pull, pipeline: ee04_bw1). FRAME_SLOT
// comes from the PlatformIO env: `pio run -e frame1` / `-e frame2`.
#if FRAME_SLOT == 1
#define DEVICE_TOKEN "CHANGE_ME_TOKEN_FRAME_1"
#elif FRAME_SLOT == 2
#define DEVICE_TOKEN "CHANGE_ME_TOKEN_FRAME_2"
#else
#error "Unknown FRAME_SLOT -- build with -e frame1 or -e frame2 (see platformio.ini)"
#endif
